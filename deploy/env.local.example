# ============================================================
# WASL AI — the local environment file (EXAMPLE ONLY)
# ------------------------------------------------------------
# ⛔ EVERY VALUE BELOW IS SYNTHETIC: it is a local fixture for a
#   compose run on a developer machine, not a credential.
# ⛔ It exists so the compose example is RUNNABLE locally without
#   writing a secret in the repository. \u26d4 A real environment file
#   lives outside the working tree and is never committed.
# ⛔ Copy it next to the compose file as `env.local` (git ignored) and
#   change every value before any shared use.
# ------------------------------------------------------------

# ------------------------------------------------------------
# The local compose network
# ------------------------------------------------------------
WASL_PG_DATABASE=wasl_local
POSTGRES_USER=wasl_local_owner
POSTGRES_PASSWORD=local-synthetic-only-not-a-secret

# The two roles of the application database (the migration role and
# the request role). The setup command generates the real ones and
# writes them in .local/pg-credentials.json.
WASL_PG_OWNER_PASSWORD=local-synthetic-only-not-a-secret
WASL_PG_PASSWORD=local-synthetic-only-not-a-secret

# ------------------------------------------------------------
# The server
# ------------------------------------------------------------
WASL_SERVER_HOST=0.0.0.0
WASL_SERVER_PORT=8787
WASL_SESSION_TTL_SECONDS=900
WASL_LOG_LEVEL=info
WASL_ENV=staging

# The synthetic fixture passcode of the seed.
WASL_TEST_PASSCODE=local-synthetic-passcode

# The login budgets (the platform one is the hard ceiling).
WASL_LOGIN_MAX_ATTEMPTS=5
WASL_LOGIN_MAX_TENANT_ATTEMPTS=20
WASL_LOGIN_MAX_GLOBAL_ATTEMPTS=200
WASL_LOGIN_MAX_PEER_ATTEMPTS=0
WASL_LOGIN_TRUST_PEER_ADDRESS=0
