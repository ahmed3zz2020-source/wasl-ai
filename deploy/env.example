# ============================================================
# WASL AI — environment template (EXAMPLE ONLY)
# ------------------------------------------------------------
# ⛔ THIS FILE MUST NEVER HOLD A REAL SECRET.
# ⛔ Every value below is a PLACEHOLDER. Replace nothing here and
#   commit nothing here: a real environment file lives outside the
#   repository (or in an ignored path) and is never committed with
#   real values.
# ⛔ This file is inert documentation. It was never loaded by any
#   process and it starts nothing.
# ------------------------------------------------------------
# ⭐ Source of truth for the names below: server/config.ts
#   (plus two variables read by the tools in tools/).
# ⭐ See deploy/README.md for the full description of each
#   variable and for the profiles.
# ============================================================

# ------------------------------------------------------------
# Database (PostgreSQL)
# ------------------------------------------------------------
WASL_PG_HOST=<paste-here>
WASL_PG_PORT=<paste-here>
WASL_PG_DATABASE=<paste-here>

# Secret: the request role (wasl_app, NOBYPASSRLS).
WASL_PG_PASSWORD=CHANGE_ME

# Secret: the migration/seed role (wasl_owner).
WASL_PG_OWNER_PASSWORD=CHANGE_ME

# Secret-bearing superuser URL used only by "npm run db:setup".
# It embeds a credential: supply it in the operator shell only,
# never in a file inside the repository.
WASL_PG_SUPERUSER_URL=CHANGE_ME

# ------------------------------------------------------------
# Server (HTTP listener)
# ------------------------------------------------------------
WASL_SERVER_HOST=<paste-here>
WASL_SERVER_PORT=<paste-here>

# ------------------------------------------------------------
# Sessions
# ------------------------------------------------------------
WASL_SESSION_TTL_SECONDS=<paste-here>

# ------------------------------------------------------------
# Testing
# ------------------------------------------------------------
# Secret: the synthetic fixture passcode used by the database seed.
WASL_TEST_PASSCODE=CHANGE_ME

# Base URL of an already-running server, used by "npm run e2e".
WASL_SERVER_URL=<paste-here>

# ------------------------------------------------------------
# Profile (read by server/config.ts)
# ------------------------------------------------------------
# ⭐ WASL_ENV selects the profile: development | test | staging.
#   The staging profile fails closed without an explicit
#   WASL_SERVER_HOST (an implicit bind host is a deployment bug).
# ⭐ WASL_LOG_LEVEL overrides the level of the profile:
#   debug | info | warn | error | silent.
WASL_ENV=<paste-here>
WASL_LOG_LEVEL=<paste-here>

# ------------------------------------------------------------
# Login rate limit (read by server/config.ts)
# ------------------------------------------------------------
# The counter lives in PostgreSQL, so the limit is shared by every
# backend instance. The values below are the profile defaults.
WASL_LOGIN_MAX_ATTEMPTS=<paste-here>
WASL_LOGIN_MAX_TENANT_ATTEMPTS=<paste-here>
WASL_LOGIN_WINDOW_SECONDS=<paste-here>
